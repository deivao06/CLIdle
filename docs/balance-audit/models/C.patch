diff --git a/internal/game/balance.go b/internal/game/balance.go
index e57928b..cb73c58 100644
--- a/internal/game/balance.go
+++ b/internal/game/balance.go
@@ -29,17 +29,26 @@ func StepsPerSec(spd int) float64 { return 1 + float64(spd)*0.5 }
 
 func XPToNext(level int) int { return int(20 * math.Pow(1.5, float64(level-1))) }
 
+// Reference hero on arrival at a floor (linear fits of the audit runs); monsters keep their designed fight
+// length at their first floor and track these curves deeper.
 const (
-	MonsterGrowth     = 1.15
-	MonsterGrowthDeep = 1.12
-	MonsterDeepFrom   = 20
+	RefAtk0, RefAtkPer = 4, 4
+	RefHP0, RefHPPer   = 20, 9
+	RefDefPer          = 4
 )
 
-// MonsterScale grows a monster by MonsterGrowth per floor below its first floor, and by MonsterGrowthDeep past MonsterDeepFrom.
+func refAtk(d int) float64 { return RefAtk0 + RefAtkPer*float64(d) }
+func refHP(d int) float64  { return RefHP0 + RefHPPer*float64(d) }
+
+// MonsterScale is the HP, defense and XP factor: a monster takes as many hits as at its first floor.
 func MonsterScale(depth, minDepth int) float64 {
-	shallow := max(0, min(depth, MonsterDeepFrom)-min(minDepth, MonsterDeepFrom))
-	deep := max(0, depth-max(minDepth, MonsterDeepFrom))
-	return math.Pow(MonsterGrowth, float64(shallow)) * math.Pow(MonsterGrowthDeep, float64(deep))
+	return refAtk(max(depth, minDepth)) / refAtk(minDepth)
+}
+
+// MonsterAtk keeps the rounds a monster needs to kill the reference hero, past the hero's growing defense.
+func MonsterAtk(atk, depth, minDepth int) int {
+	s := refHP(max(depth, minDepth)) / refHP(minDepth)
+	return int(float64(atk)*MonsterAtkMult*s + RefDefPer*float64(max(0, depth-minDepth))/2 + 0.5)
 }
 
 // MissChance and CritChance are the same for heroes and monsters.
